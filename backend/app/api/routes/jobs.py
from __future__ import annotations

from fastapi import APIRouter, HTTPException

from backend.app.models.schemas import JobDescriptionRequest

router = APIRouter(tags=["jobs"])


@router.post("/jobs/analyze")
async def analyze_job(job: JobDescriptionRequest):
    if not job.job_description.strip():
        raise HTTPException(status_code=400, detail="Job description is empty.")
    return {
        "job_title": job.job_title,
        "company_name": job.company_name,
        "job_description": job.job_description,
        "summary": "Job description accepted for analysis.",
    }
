from __future__ import annotations

from fastapi import APIRouter, File, HTTPException, UploadFile

from backend.app.db.mongo import analysis_store
from backend.app.models.schemas import AnalysisRequest, CompareRequest, CompareRow, JobDescriptionRequest
from backend.app.services.roadmap_generator import generate_learning_roadmap
from backend.app.services.matching_engine import analyze_resume_job_match
from backend.app.services.pdf_parser import extract_text_from_pdf

router = APIRouter(tags=["resume"])


@router.post("/resume/upload")
async def upload_resume(file: UploadFile = File(...)):
    try:
        extracted_text, pages = extract_text_from_pdf(file)
        return {
            "resume_name": file.filename,
            "extracted_text": extracted_text,
            "pages": pages,
        }
    except HTTPException:
        raise
    except Exception as exc:  # pragma: no cover
        raise HTTPException(status_code=500, detail="Unable to process the resume upload.") from exc


@router.post("/jobs/analyze")
async def analyze_job(job: JobDescriptionRequest):
    if not job.job_description.strip():
        raise HTTPException(status_code=400, detail="Job description is empty.")
    return {
        "job_title": job.job_title,
        "company_name": job.company_name,
        "job_description": job.job_description,
        "summary": "Job description accepted for analysis.",
    }


@router.post("/analyze")
async def analyze_resume_and_job(payload: AnalysisRequest):
    result = analyze_resume_job_match(
        resume_text=payload.resume_text,
        job_description=payload.job_description,
        resume_name=payload.resume_name,
        job_title=payload.job_title,
        company_name=payload.company_name,
    )
    result["learning_roadmap"] = generate_learning_roadmap(result["missing_skills"])

    if not result["analysis_id"]:
        result["analysis_id"] = "analysis_" + str(len(analysis_store.list_analyses()) + 1)

    analysis_store.save_analysis(result)
    return result


@router.post("/compare")
async def compare_jobs(payload: CompareRequest):
    rows: list[dict] = []
    for job in payload.jobs:
        result = analyze_resume_job_match(
            resume_text=payload.resume_text,
            job_description=job.job_description,
            job_title=job.job_title,
            company_name=job.company_name,
        )
        rows.append({
            "job_title": job.job_title or "Position",
            "company_name": job.company_name,
            "overall_score": result["overall_score"],
            "matched_skills": result["matched_skills"],
            "missing_skills": result["missing_skills"],
        })
    return rows


@router.get("/analysis/history")
async def list_history():
    return analysis_store.list_analyses()


@router.get("/analysis/{analysis_id}")
async def get_analysis(analysis_id: str):
    result = analysis_store.get_analysis(analysis_id)
    if not result:
        raise HTTPException(status_code=404, detail="Analysis not found.")
    return result


@router.delete("/analysis/{analysis_id}")
async def delete_analysis(analysis_id: str):
    deleted = analysis_store.delete_analysis(analysis_id)
    if not deleted:
        raise HTTPException(status_code=404, detail="Analysis not found.")
    return {"deleted": True, "analysis_id": analysis_id}
